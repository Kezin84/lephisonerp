{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lephisonerp",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-12",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/zalo-bot-api/*", "/api/zalo-bot/*"]
  },
  "triggers": {
    "crons": ["* * * * *"]
  }
}
